{
  "name": "pellucid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "packageManager": "bun@1.1.42",
  "workspaces": [
    "webview"
  ],
  "scripts": {
    "typecheck": "bun run --filter='*' typecheck",
    "lint": "bun run --filter='*' lint",
    "test": "bun run --filter='*' test",
    "build": "bun run --filter=webview build",
    "dev": "bun run --filter=webview dev",
    "e2e": "bunx playwright test",
    "e2e:visual": "bunx playwright test --project=web-visual",
    "e2e:desktop": "bunx wdio run wdio.conf.ts",
    "format": "bun run --filter='*' format",
    "clean": "bun run --filter='*' clean && rm -rf node_modules .bun"
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "@types/bun": "1.1.14",
    "@types/node": "22.10.5",
    "@wdio/cli": "9.4.4",
    "@wdio/local-runner": "9.4.4",
    "@wdio/mocha-framework": "9.4.4",
    "@wdio/spec-reporter": "9.4.4",
    "@wdio/types": "9.4.4",
    "typescript": "5.7.2",
    "webdriverio": "9.4.4"
  },
  "engines": {
    "bun": ">=1.1.0"
  }
}
