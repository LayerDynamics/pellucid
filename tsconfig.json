{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["@types/node", "@types/bun"]
  },
  "include": ["playwright.config.ts", "wdio.conf.ts", "e2e/**/*.ts", "tools/**/*.ts"],
  "exclude": ["node_modules", "**/dist", "webview", "convex"]
}
