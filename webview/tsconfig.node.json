{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": false,
    "composite": true,
    "incremental": true,
    "outDir": "./.vite-tsbuildinfo",
    "tsBuildInfoFile": "./.vite-tsbuildinfo/tsconfig.node.tsbuildinfo"
  },
  "include": ["vite.config.ts"]
}
